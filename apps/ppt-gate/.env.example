# Copy to .env and replace every value. Never commit .env.
APP_ENV=dev
DATABASE_PATH=data/ppt_gate.db
PUBLIC_BASE_URL=http://127.0.0.1:8009

PRESENTON_BASE_URL=http://127.0.0.1:5001
PRESENTON_ADMIN_USERNAME=phase0admin
PRESENTON_ADMIN_SECRET=replace-with-real-presenton-admin-secret
PRESENTON_TIMEOUT_SECONDS=60

# Set each of the following to a random value of at least 32 characters.
# Keep them stable: changing them invalidates existing sessions and makes
# stored shadow-user credentials unreadable.
GATE_SECRET=
CARD_PEPPER=
GATE_ADMIN_TOKEN=

SESSION_TTL_SECONDS=2592000
CARD_DEFAULT_VALID_DAYS=7
COOKIE_SECURE=false
REDEEM_LANDING_ENABLED=true
# COOKIE_DOMAIN=.example.com
PROXY_READ_TIMEOUT_SECONDS=600

# Metering and budget. DAILY_BUDGET_CENTS=-1 means unlimited.
METERING_ENABLED=true
DENY_UNKNOWN_WRITES=false
DEFAULT_DAILY_BUDGET_CENTS=10000
ESTIMATED_GENERATION_CENTS=20
ESTIMATED_AI_EDIT_CENTS=5
ESTIMATED_IMAGE_CENTS=10
MAX_CONCURRENT_GENERATIONS=2
MAX_CONCURRENT_GENERATIONS_PER_CARD=1
RESERVATION_TTL_SECONDS=1800
SETTLEMENT_INTERVAL_SECONDS=10

# Xianyu card-group import uses a dedicated front-end tenant user.
# The gate calls POST /api/login/login and POST /api/cards/{id}/items/batch.
XIANYU_IMPORT_ENABLED=false
XIANYU_API_BASE_URL=http://127.0.0.1:18080
XIANYU_USERNAME=
XIANYU_SECRET=
# XIANYU_CARD_GROUP_ID=12
XIANYU_CARD_GROUP_NAME=AI PPT 兑换码
XIANYU_TIMEOUT_SECONDS=30
